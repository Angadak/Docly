{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=docassistant;Username=postgres"
  },
  "Jwt": {
    "Issuer": "DoclyApi",
    "Audience": "DoclyApiUsers",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "RootPath": "uploaded-files"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "llama3.1:8b",
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "EmbeddingTimeoutSeconds": 60,
    "ChatTimeoutSeconds": 180
  },
  "Rag": {
    "DefaultTopN": 5,
    "MaxTopN": 10,
    "MinSimilarity": 0.3,
    "HistoryMessages": 6
  },
  "WebClientOrigins": [ "https://localhost:7201", "http://localhost:5201" ],
  "Database": {
    "MigrateOnStartup": false
  },
  "UseHttpsRedirection": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
