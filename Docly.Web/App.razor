@using Docly.Web.Pages

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Components.Layout)">
            <p style="padding:2rem;">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
