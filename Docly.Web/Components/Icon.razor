@* Inline stroke icons (24x24 grid) so the UI has no icon-font dependency. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "send": <path d="M12 19V5M5 12l7-7 7 7" /> break;
        case "stop": <rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor" stroke="none" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /> break;
        case "sidebar": <rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /> break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h10" /> break;
        case "file": <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /> break;
        case "files": <path d="M15 3H9a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7z" /><path d="M15 3v4h4" /><path d="M5 7v12a2 2 0 0 0 2 2h8" /> break;
        case "paperclip": <path d="m20.5 11.5-8.3 8.3a5 5 0 0 1-7-7l8.6-8.6a3.4 3.4 0 0 1 4.8 4.8l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4l7.9-7.9" /> break;
        case "upload": <path d="M12 15V4M7 9l5-5 5 5" /><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /> break;
        case "x": <path d="M6 6l12 12M18 6 6 18" /> break;
        case "trash": <path d="M4 7h16M10 11v6M14 11v6" /><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" /> break;
        case "copy": <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /> break;
        case "check": <path d="m5 12 5 5L20 7" /> break;
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /> break;
        case "moon": <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /> break;
        case "logout": <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11" /> break;
        case "sparkle": <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" /><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z" /> break;
        case "message": <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /> break;
        case "alert": <circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.01" /> break;
        case "refresh": <path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /> break;
        case "list": <path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" /> break;
        case "calendar": <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /> break;
        case "lightbulb": <path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z" /> break;
        case "scale": <path d="M12 3v18M7 21h10M5 7h14M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z" /> break;
        case "chevron-down": <path d="m6 9 6 6 6-6" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public double StrokeWidth { get; set; } = 1.8;
    [Parameter] public string? Class { get; set; }
}
