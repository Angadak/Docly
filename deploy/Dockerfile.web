# ---- Docly Web (Blazor WebAssembly) served by nginx ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["Docly.Web/Docly.Web.csproj", "Docly.Web/"]
RUN dotnet restore "Docly.Web/Docly.Web.csproj"
COPY Docly.Web/ Docly.Web/
RUN dotnet publish "Docly.Web/Docly.Web.csproj" -c Release -o /app/publish --no-restore

FROM nginx:1.27-alpine AS final
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html
# The browser calls the API directly; set the public API URL when starting the container.
COPY deploy/web-entrypoint.sh /docker-entrypoint.d/40-docly-config.sh
RUN chmod +x /docker-entrypoint.d/40-docly-config.sh
EXPOSE 80
